# Copia este archivo a .env.local y llena los valores. NUNCA subas .env.local al repositorio.
# Todas las cuentas y llaves las crea el dueño del negocio.

# --- App ---
# URL pública (sin / al final). En desarrollo: http://localhost:3000
APP_URL=
# Secreto para firmar sesiones y enlaces. Mínimo 32 caracteres al azar: `openssl rand -base64 48`
APP_SECRET=
# Identificador del negocio en la base (el seed crea "dgarden")
BUSINESS_SLUG=dgarden

# --- Base de datos (Postgres: Supabase, Neon o local) ---
# Supabase: Project Settings > Database > Connection string > Transaction pooler (puerto 6543)
DATABASE_URL=
DATABASE_POOL_MAX=5
# Opcional: conexión para las migraciones del deploy (Supabase: "Session pooler" o directa, puerto 5432).
# El build de producción en Vercel corre las migraciones solo (scripts/deploy-migrate.mjs).
DATABASE_URL_MIGRATIONS=
# Solo para `npm run db:seed`: el correo con el que el dueño entra al panel
SEED_ADMIN_EMAIL=

# --- Correo (Resend) ---
# resend.com > API Keys. EMAIL_FROM debe ser de un dominio verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM="D' Garden Tacos <avisos@tu-dominio.mx>"

# --- Pagos (Mercado Pago Checkout Pro) ---
# mercadopago.com.mx/developers > Tus integraciones > tu aplicación > Credenciales.
# Empieza con las credenciales de PRUEBA (TEST-...). Las de producción hasta /replica-deploy.
MP_ACCESS_TOKEN=
# Tus integraciones > Webhooks > Configurar notificaciones > Clave secreta.
# URL del webhook: {APP_URL}/api/webhooks/mercadopago, evento "Pagos".
MP_WEBHOOK_SECRET=

# --- Fotos (Supabase Storage) ---
# Crea un bucket PÚBLICO llamado "fotos". La service role key va SOLO en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=fotos

# --- Job diario (Vercel Cron manda "Authorization: Bearer CRON_SECRET") ---
CRON_SECRET=

# --- Antispam opcional (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
